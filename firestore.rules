rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /coops/{doc} {
      function signedIn() {
        return request.auth != null;
      }

      // True when the stored document carries the named list under meta.
      // Only evaluated for documents that already exist.
      function hasMetaList(field) {
        return resource.data.data is map
          && resource.data.data.meta is map
          && field in resource.data.data.meta;
      }

      function validShape() {
        return request.resource.data.keys().hasAll(['data', 'updatedAt'])
          && request.resource.data.data is map;
      }

      // Reads require a signed-in account. When accessUids is present, only
      // users whose Firebase UID is listed may read (pending applicants are not).
      allow read: if signedIn() && (
        !exists(/databases/$(database)/documents/coops/$(doc))
        || !hasMetaList('accessUids')
        || request.auth.uid in resource.data.data.meta.accessUids
      );

      // First-time setup: only possible while the document does not exist, and
      // the creator must register themselves as an administrator.
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/coops/$(doc))
        && validShape()
        && request.resource.size() < 1048576
        && request.resource.data.data.meta is map
        && 'adminUids' in request.resource.data.data.meta
        && request.auth.uid in request.resource.data.data.meta.adminUids;

      // Once adminUids is stored, only listed administrators may overwrite the
      // dataset. Documents without adminUids are treated as legacy and remain
      // writable until a Firebase-backed administrator signs in and migrates them.
      allow update: if signedIn()
        && validShape()
        && request.resource.size() < 1048576
        && (
          !hasMetaList('adminUids')
          || (
            request.resource.data.data.meta is map
            && 'adminUids' in request.resource.data.data.meta
            && request.auth.uid in resource.data.data.meta.adminUids
          )
        );

      allow delete: if signedIn()
        && (
          !hasMetaList('adminUids')
          || request.auth.uid in resource.data.data.meta.adminUids
        );
    }
  }
}
